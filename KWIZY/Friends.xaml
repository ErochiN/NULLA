<Page x:Class="KWIZY.Friends"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111827">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#0E1319" Padding="20">

            <StackPanel>

                <Button x:Name="Profil"
                        Content="Профиль"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        Click="Profil_Click"/>

                <Button x:Name="friends"
                        Content="Друзья"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"
                        Click="friends_Click"/>

                <Button x:Name="massage"
                        Content="Сообщения"
                        Height="45"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        Click="massage_Click"/>

            </StackPanel>

        </Border>

        <!-- USERS -->
        <Border Grid.Column="1"
                Margin="15"
                Background="#1F2937"
                CornerRadius="20"
                Padding="15">

            <StackPanel>

                <TextBox x:Name="SearchTextBox"
                         Height="45"
                         Background="#111827"
                         Foreground="White"
                         BorderBrush="#00ff89"
                         BorderThickness="2"
                         Padding="10"
                         Margin="0,0,0,10"/>

                <Button x:Name="SearchButton"
                        Content="Поиск"
                        Height="40"
                        Background="#00ff89"
                        Foreground="Black"
                        Click="SearchButton_Click"/>

                <Button x:Name="GetFriendsButton"
                        Content="Обновить"
                        Height="40"
                        Margin="0,10,0,10"
                        Background="#00ff89"
                        Foreground="Black"
                        Click="GetFriendsButton_Click"/>

                <ListBox x:Name="UserListBox"
                         Background="Transparent"
                         BorderThickness="0">

                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Border Background="#111827"
                                    CornerRadius="15"
                                    Margin="0,0,0,10"
                                    Padding="15">

                                <StackPanel>

                                    <TextBlock Text="{Binding NickName}"
                                               FontSize="16"
                                               Foreground="White"
                                               FontWeight="Bold"/>

                                    <TextBlock Text="{Binding UserName}"
                                               Foreground="#9CA3AF"/>

                                    <Button Content="Добавить"
                                            Margin="0,10,0,0"
                                            Background="#00ff89"
                                            Foreground="Black"
                                            BorderThickness="0"
                                            Click="AddFriendButton_Click"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>

        </Border>

        <!-- FRIENDS LIST -->
        <Border Grid.Column="2"
                Margin="15"
                Background="#1F2937"
                CornerRadius="20"
                Padding="15">

            <ListBox x:Name="FriendsListBox"
                     Background="Transparent"
                     BorderThickness="0">

                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <Border Background="#111827"
                                CornerRadius="15"
                                Margin="0,0,0,10"
                                Padding="15">

                            <StackPanel>

                                <TextBlock Text="{Binding NickName}"
                                           FontSize="16"
                                           Foreground="White"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding UserName}"
                                           Foreground="#9CA3AF"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>
                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

    </Grid>
</Page>
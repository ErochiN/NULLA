<Page x:Class="KWIZY.Friends"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KWIZY"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Friends"
      Background="#111827">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="22" Grid.Row="0" Background="#FF1F2937"/>

        <TextBlock Grid.Column="3" Grid.Row="0" Grid.ColumnSpan="16" Text="KWIZY" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

        <TextBox x:Name="SearchTextBox" 
                 Grid.Row="1"
                 Grid.Column="3"
                 Grid.ColumnSpan="9"
                 Background="{x:Null}" 
                 BorderBrush="#FF00FF89"
                 Foreground="#FF00FF89" 
                 FontSize="16"
                 Padding="12"/>

        <Button x:Name="SearchButton"
                Grid.Row="1" 
                Grid.Column="12" 
                Grid.ColumnSpan="1" 
                Content="🔍" 
                Background="#00ff89"
                Foreground="Black" Click="SearchButton_Click"/>

        <Button x:Name="GetFriendsButton"
                Grid.Row="1" 
                Grid.Column="21" 
                Grid.ColumnSpan="1" 
                Content="🔄️" 
                Background="#00ff89"
                Foreground="Black" Click="GetFriendsButton_Click"/>

        <ListBox x:Name="FriendsListBox"
                 Background="#111827"
                 BorderThickness="0"
                 Foreground="White"
                 Grid.Row="2" 
                 Grid.Column="13" 
                 Grid.RowSpan="11" 
                 Grid.ColumnSpan="9"
                 BorderBrush="#00ff89">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border Background="#1F2937"
                            CornerRadius="10"
                            Margin="0,0,0,10"
                            Padding="12">

                        <StackPanel>

                            <TextBlock Text="{Binding NickName}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>

                            <TextBlock Text="{Binding UserName}"
                       FontSize="13"
                       Foreground="#9CA3AF"/>

                            <Button x:Name="AddFriendButton"
                            Grid.Row="1" 
                            Grid.Column="12" 
                            Grid.ColumnSpan="1" 
                            Content="➕" 
                            Background="#00ff89"
                            Foreground="Black" Click="AddFriendButton_Click"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <ListBox x:Name="UserListBox"
         Background="#111827"
         BorderThickness="0"
         Foreground="White"
         Grid.Row="2" 
         Grid.Column="3" 
         Grid.RowSpan="11" 
         Grid.ColumnSpan="10"
         BorderBrush="#00ff89">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border Background="#1F2937"
                    CornerRadius="10"
                    Margin="0,0,0,10"
                    Padding="12">

                        <StackPanel>

                            <TextBlock Text="{Binding NickName}"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"/>

                            <TextBlock Text="{Binding UserName}"
                               FontSize="13"
                               Foreground="#9CA3AF"/>

                            <Button x:Name="AddFriendButton"
                                    Grid.Row="1" 
                                    Grid.Column="12" 
                                    Grid.ColumnSpan="1" 
                                    Content="➕" 
                                    Background="#00ff89"
                                    Foreground="Black" Click="AddFriendButton_Click"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <Border Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="13" Background="#FF0E1319" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="40.536"></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>

                </Grid.ColumnDefinitions>

                <Button x:Name="Profil"
    FontWeight="SemiBold"
        Background="#00ff89"
        Foreground="Black"
        BorderThickness="0"
        Cursor="Hand"
        Content="Профиль"
        Margin="5"
        FontSize="12"
        Grid.ColumnSpan="3" Click="Profil_Click"/>

                <Button x:Name="friends"
    FontWeight="SemiBold"
        Background="#FF374151"
        Foreground="White"
        BorderThickness="0"
        Cursor="Hand"
        Content="Друзья"
        Margin="5"
        Grid.Row="1"
        FontSize="12"
        Grid.ColumnSpan="3" Click="friends_Click"/>

                <Button x:Name="massage"
    FontWeight="SemiBold"
        Background="#00ff89"
        Foreground="Black"
        BorderThickness="0"
        Cursor="Hand"
        Content="Сообщения"
        Margin="5"
        FontSize="12"
        Grid.Row="2"
        Grid.ColumnSpan="3" Click="massage_Click"/>
            </Grid>
        </Border>

    </Grid>
</Page>

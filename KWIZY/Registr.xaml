<Page x:Class="KWIZY.Registr"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KWIZY"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1280"
      Title="Registr"
      Background="#111827">

    <Grid Margin="0,0,0,10">

        <Border Width="420"
                Height="680"
                Background="#1F2937"
                CornerRadius="18"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- LOGO -->

                <TextBlock Text="NULLA"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
                <TextBlock Text="Username"
                           Foreground="White"
                           FontSize="14"
                           />
                <TextBox x:Name="UsernameTextBox"
                         Height="42"
                         FontSize="14"
                         Background="#374151"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="12"
                         />
                <TextBlock Text="Email"
                           Foreground="White"
                           FontSize="14"
                           />
                <TextBox x:Name="EmailTextBox"
                         Height="42"
                         FontSize="14"
                         Background="#374151"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="12"
                         />
                <TextBlock Text="Nickname"
                           Foreground="White"
                           FontSize="14"
                           />
                <TextBox x:Name="NicknameTextBox"
                         Height="42"
                         FontSize="14"
                         Background="#374151"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="12"
                         
                         />
                <TextBlock Text="Password"
                           Foreground="White"
                           FontSize="14"
                           />
                <PasswordBox x:Name="PasswordBox"
                             Height="42"
                             FontSize="14"
                             Background="#374151"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="12"
                             />
                <TextBlock Text="Confirm password"
                           Foreground="White"
                           FontSize="14"
                           />
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="42"
                             FontSize="14"
                             Background="#374151"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="12"
                             
                             />

                <TextBlock Text="Date of Birth"
                           Foreground="White"
                           FontSize="14"
                           />

                <DatePicker x:Name="DateOfBirthDatePicker"
                         Height="42"
                         FontSize="14"
                         Background="#374151"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="12"
                         Margin="0, 0, 0, 10" BorderBrush="#FF374151"
                         >
                    <DatePicker.CalendarStyle>
                        <Style TargetType="{x:Type Calendar}">
                            <Setter Property="Background" Value="#FF374151" />
                            <Setter Property="Foreground" Value="White" />
                        </Style>
                    </DatePicker.CalendarStyle>
                    <DatePicker.Resources>
                        <Style TargetType="DatePickerTextBox">
                            <Setter Property="Background" Value="#FF374151" />
                            <Setter Property="BorderBrush" Value="#FF374151" />
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>


                    <Button x:Name="BackButton"
                        Content="Back"
                        Height="42"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BackButton_Click"/>

                <!-- USERNAME -->

                <!-- EMAIL -->

                <!-- NICKNAME -->

                <!-- PASSWORD -->

                <!-- CONFIRM PASSWORD -->
                <Button x:Name="RegisterButton"
                        Content="Create account"
                        Height="46"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand" Click="RegisterButton_Click"
                        />

                <!-- STATUS -->

                <TextBlock x:Name="StatusText"
                           Foreground="#EF4444"
                           FontSize="13"
                           Margin="0,0,0,18"
                           TextWrapping="Wrap"/>

                <!-- REGISTER BUTTON -->

                <!-- BACK BUTTON -->

                <!-- LOGIN -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Already have an account?"
                               Foreground="#9CA3AF"
                               FontSize="13"/>

                    <TextBlock Text=" Login"
                               Foreground="#00ff89"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Cursor="Hand"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Page>
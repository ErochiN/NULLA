<Page x:Class="KWIZY.Profil"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:KWIZY"
      mc:Ignorable="d" 
      d:DesignHeight="720" d:DesignWidth="1280"
      Title="Profil"
      Background="#111827">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="3" Grid.Row="0" Grid.ColumnSpan="16" Text="KWIZY" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
        
        <TextBox Grid.Row="5"
                 Grid.Column="8"
                 Grid.RowSpan="3"
                 Grid.ColumnSpan="6"
                 Background="{x:Null}" 
                 BorderBrush="#FF00FF89"
                 Foreground="#FF00FF89"
                 FontFamily="GOST Type BU"/>

        <Button Grid.Row="8"
                Grid.Column="13"
                Grid.RowSpan="1"
                Grid.ColumnSpan="1"
                Background="#00ff89"
                Foreground="Black"
                FontFamily="GOST Type BU"
                Height="30"
                Content="Cохранить" Click="Button_Click"/>

        <Border Grid.ColumnSpan="22" 
                Grid.Row="0" 
                Background="#FF1F2937"/>
        
        <Image  Grid.ColumnSpan="3" 
                Grid.Row="2" 
                Grid.Column="4" 
                Grid.RowSpan="3" 
                Source="/NULLA.png" />
        
        <TextBlock Grid.Row="2" 
                 Grid.Column="8" 
                 Grid.ColumnSpan="7"  
                 FontSize="20" 
                 RenderTransformOrigin="0.5,0.5" 
                 VerticalAlignment="Bottom"
                 Background="{x:Null}" 
                 Foreground="#FF00FF89"
                 FontFamily="GOST Type BU"
                 x:Name="Nickname"/>
        
        <TextBlock Grid.Row="3" 
                 Grid.Column="8" 
                 Grid.ColumnSpan="7" 
                 RenderTransformOrigin="0.5,0.5" 
                 VerticalAlignment="Top"
                 Background="{x:Null}" 
                 Foreground="#FF00FF89"
                 FontFamily="GOST Type BU" 
                 FontStyle="Italic" HorizontalAlignment="Left"
                 x:Name="Username"/>

        <TextBlock Grid.Row="4" 
                 Grid.Column="8" 
                 Grid.ColumnSpan="7" 
                 Text="Описание" 
                 RenderTransformOrigin="0.5,0.5" 
                 VerticalAlignment="Bottom"
                 Background="{x:Null}" 
                 Foreground="#FF00FF89"
                 FontFamily="GOST Type BU" 
                 FontStyle="Italic" HorizontalAlignment="Left"/>

        <Border Grid.ColumnSpan="3" 
                Grid.Row="1" 
                Grid.RowSpan="13" 
                Background="#FF0E1319" 
                Padding="10">


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>

                </Grid.ColumnDefinitions>

                <Button x:Name="profil"
                    FontWeight="SemiBold"
                    Background="#FF374151"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Content="Профиль"
                    Margin="5"
                    FontSize="12"
                    Grid.ColumnSpan="3" Click="profil_Click"/>

                <Button x:Name="frineds"
                    FontWeight="SemiBold"
                    Background="#00ff89"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand"
                    Content="Друзья"
                    Margin="5"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    FontSize="12" Click="frineds_Click"/>

                <Button x:Name="message"
                    FontWeight="SemiBold"
                    Background="#00ff89"
                    Foreground="Black"
                    BorderThickness="0"
                    Cursor="Hand"
                    Content="Сообщения"
                    Margin="5"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    FontSize="12" Click="message_Click"/>
            </Grid>
        </Border>

    </Grid>
</Page>

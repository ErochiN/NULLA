<Page x:Class="KWIZY.Profil"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#111827">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Background="#0E1319" Padding="20">

            <StackPanel>

                <Button x:Name="profil"
                        Content="Профиль"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"
                        Click="profil_Click"/>

                <Button x:Name="frineds"
                        Content="Друзья"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        Click="frineds_Click"/>

                <Button x:Name="message"
                        Content="Сообщения"
                        Height="45"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        Click="message_Click"/>

            </StackPanel>

        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1">

            <Border Margin="20"
                    Background="#1F2937"
                    CornerRadius="25"
                    Padding="30">

                <StackPanel>

                    <TextBlock Text="Профиль"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Никнейм"
                               Foreground="#9CA3AF"/>

                    <TextBlock x:Name="Nickname"
                               FontSize="20"
                               Foreground="#00ff89"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="Username"
                               Foreground="#9CA3AF"/>

                    <TextBlock x:Name="Username"
                               FontSize="18"
                               Foreground="White"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Описание"
                               Foreground="#9CA3AF"
                               Margin="0,0,0,5"/>

                    <TextBox Background="#111827"
                             Foreground="White"
                             BorderBrush="#00ff89"
                             BorderThickness="2"
                             FontSize="16"
                             Padding="10"
                             Height="120"/>

                    <Button Content="Сохранить"
                            Height="45"
                            Margin="0,20,0,0"
                            Background="#00ff89"
                            Foreground="Black"
                            BorderThickness="0"
                            Click="Button_Click"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>
</Page>

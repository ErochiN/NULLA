<Page x:Class="KWIZY.mess"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KWIZY"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1280"
      Title="MainPage"
      Background="#111827">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="51.429"></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="22" Grid.Row="0" Background="#FF1F2937"/>
        
        <TextBlock Grid.Column="3" Grid.Row="0" Grid.ColumnSpan="16" Text="KWIZY" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>

        <TextBox x:Name="MessageTextBox" Grid.Row="13"
                 Grid.Column="3"
                 Grid.ColumnSpan="18"
                 Background="{x:Null}" 
                 BorderBrush="#FF00FF89"
                 Foreground="#FF00FF89"
                 FontFamily="GOST Type BU"
                 AcceptsReturn ="True"
                 TextWrapping="Wrap"
                 AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" Text="Ghjhrr" FontSize="18"
                 Padding="10"/>

        <Button Grid.Row="13" Grid.Column="21" Content="Отправить" Background="#00ff89" Foreground="Black" FontFamily="GOST Type BU" Height="30" Click="puch_massage_buttom"/>

        <ListBox x:Name="FrendListBox"
                 Background="#111827"
                 BorderThickness="0"
                 Foreground="White"
                 Grid.Row="2" 
                 Grid.Column="3" 
                 Grid.RowSpan="11" 
                 Grid.ColumnSpan="3"
                 BorderBrush="#00ff89">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border Background="#1F2937"
            CornerRadius="10"
            Margin="0,0,0,10"
            Padding="12">

                        <StackPanel>

                            <TextBlock Text="{Binding NickName}"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="White"/>

                            <TextBlock Text="{Binding UserName}"
                       FontSize="13"
                       Foreground="#9CA3AF"/>

                            <Button x:Name="AddFriendButton"
                            Grid.Row="1" 
                            Grid.Column="12" 
                            Grid.ColumnSpan="1" 
                            Content="➕" 
                            Background="#00ff89"
                            Foreground="Black" Click="AddFriendButton_Click"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <ListBox x:Name="MessagesListBox"
                 Background="#010827"
                 BorderThickness="0"
                 Foreground="White"
                 Grid.Row="2" 
                 Grid.Column="6" 
                 Grid.RowSpan="11" 
                 Grid.ColumnSpan="15"
                 BorderBrush="#00ff89">

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Border Background="#1F2937"
                            CornerRadius="10"
                            Margin="0,0,0,10"
                            Padding="12">

                        <StackPanel>

                            <TextBlock Text="{Binding Messages}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="White"/>

                            <TextBlock Text="{Binding FriendId}"
                                       FontSize="13"
                                       Foreground="#9CA3AF"/>

                            <TextBlock Text="{Binding Timestamp}"
                                       FontSize="13"
                                       Foreground="#9CA3AF"/>

                        </StackPanel>

                    </Border>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <Border Grid.ColumnSpan="3" Grid.Row="1" Grid.RowSpan="13" Background="#FF0E1319" Padding="10" BorderBrush="#FF00FF89">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>

                </Grid.ColumnDefinitions>

                <Button x:Name="Profil"
                    FontWeight="SemiBold"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="Профиль"
                        Margin="5"
                        FontSize="12"
                        Grid.ColumnSpan="3" Click="Profil_Click"/>

                <Button x:Name="friends"
                    FontWeight="SemiBold"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="Друзья"
                        Margin="5"
                        Grid.Row="1"
                        FontSize="12"
                        Grid.ColumnSpan="3" Click="friends_Click"/>

                <Button x:Name="massage"
                    FontWeight="SemiBold"
                        Background="#FF374151"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Content="Сообщения"
                        Margin="5"
                        FontSize="12"
                        Grid.Row="2"
                        Grid.ColumnSpan="3" Click="massage_Click"/>
                
                
                
            </Grid>
        </Border>

    </Grid>
</Page>

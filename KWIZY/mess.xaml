 <Page x:Class="KWIZY.mess"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KWIZY"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1280"
      Background="#111827">

    <Page.Resources>

        <local:AlignConverter x:Key="AlignConverter"/>
        <local:BubbleColorConverter x:Key="BubbleColorConverter"/>
        <local:TextColorConverter x:Key="TextColorConverter"/>

    </Page.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR -->

        <Border Grid.ColumnSpan="3"
                Background="#1F2937">

            <TextBlock Text="KWIZY"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="30,0,0,0"/>
        </Border>

        <!-- SIDEBAR -->

        <Border Grid.Row="1"
                Grid.RowSpan="2"
                Background="#0E1319"
                Padding="20">

            <StackPanel>

                <Button x:Name="Profil"
                        Content="Профиль"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="Profil_Click"/>

                <Button x:Name="friends"
                        Content="Друзья"
                        Height="45"
                        Margin="0,0,0,10"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="friends_Click"/>

                <Button x:Name="massage"
                        Content="Сообщения"
                        Height="45"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="Bold"
                        Click="massage_Click"/>

            </StackPanel>

        </Border>

        <!-- FRIENDS -->

        <Border Grid.Column="1"
                Grid.Row="1"
                Margin="15"
                Background="#1F2937"
                CornerRadius="20"
                Padding="15">

            <ListBox x:Name="FrendListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Border Background="#111827"
                                CornerRadius="15"
                                Margin="0,0,0,10"
                                Padding="15">

                            <StackPanel>

                                <TextBlock Text="{Binding NickName}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="{Binding UserName}"
                                           Foreground="#9CA3AF"
                                           Margin="0,5,0,10"/>

                                <Button x:Name="AddFriendButton"
                                        Content="Открыть чат"
                                        Height="35"
                                        Background="#00ff89"
                                        Foreground="Black"
                                        BorderThickness="0"
                                        Click="AddFriendButton_Click"/>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

        <!-- CHAT -->

        <Border Grid.Column="2"
                Grid.Row="1"
                Margin="15,15,15,0"
                Background="#1F2937"
                CornerRadius="20"
                Padding="15">

            <ListBox x:Name="MessagesListBox"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="White"
                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemContainerStyle>

                    <Style TargetType="ListBoxItem">

                        <Setter Property="HorizontalContentAlignment"
                                Value="Stretch"/>

                        <Setter Property="BorderThickness"
                                Value="0"/>

                        <Setter Property="Padding"
                                Value="0"/>

                        <Setter Property="Margin"
                                Value="0"/>

                    </Style>

                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Grid Margin="0,0,0,10">

                            <Border Background="{Binding IsMine, Converter={StaticResource BubbleColorConverter}}"
                                    CornerRadius="15"
                                    Padding="15"
                                    MaxWidth="450"
                                    HorizontalAlignment="{Binding IsMine, Converter={StaticResource AlignConverter}}">

                                <StackPanel>

                                    <TextBlock Text="{Binding Messages}"
                                               FontSize="16"
                                               TextWrapping="Wrap"
                                               Foreground="{Binding IsMine, Converter={StaticResource TextColorConverter}}"/>

                                    <TextBlock Text="{Binding Timestamp}"
                                               FontSize="11"
                                               Margin="0,8,0,0"
                                               Foreground="{Binding IsMine, Converter={StaticResource TextColorConverter}}"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Border>

        <!-- INPUT -->

        <Grid Grid.Column="2"
              Grid.Row="2"
              Margin="15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageTextBox"
                     Background="#1F2937"
                     Foreground="White"
                     BorderBrush="#00ff89"
                     BorderThickness="2"
                     FontSize="16"
                     Padding="15"
                     VerticalContentAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="Отправить"
                    Margin="15,0,0,0"
                    Background="#00ff89"
                    Foreground="Black"
                    FontWeight="Bold"
                    BorderThickness="0"
                    Click="puch_massage_buttom"/>

        </Grid>

    </Grid>

</Page>

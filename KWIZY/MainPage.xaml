<Page x:Class="KWIZY.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KWIZY"
      mc:Ignorable="d"
      d:DesignHeight="720"
      d:DesignWidth="1280"
      Title="MainPage"
      Background="#111827">

    <Grid>

        <Border Width="420"
                Height="500"
                Background="#1F2937"
                CornerRadius="18"
                Padding="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- LOGO -->

                <TextBlock Text="NULLA"
                           FontSize="36"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>

                <TextBlock Text="Voice Chat Platform"
                           FontSize="16"
                           Foreground="#9CA3AF"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- LOGIN -->

                <TextBlock Text="Username or Email"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="LoginTextBox"
                         Height="42"
                         FontSize="14"
                         Background="#374151"
                         Foreground="White"
                         BorderThickness="0"
                         Padding="12"
                         Margin="0,0,0,20"/>

                <!-- PASSWORD -->

                <TextBlock Text="Password"
                           Foreground="White"
                           FontSize="14"
                           Margin="0,0,0,6"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="42"
                             FontSize="14"
                             Background="#374151"
                             Foreground="White"
                             BorderThickness="0"
                             Padding="12"
                             Margin="0,0,0,30"/>

                <!-- STATUS -->

                <TextBlock x:Name="StatusText"
                           Foreground="#EF4444"
                           FontSize="13"
                           Margin="0,0,0,16"
                           TextWrapping="Wrap"/>

                <!-- LOGIN BUTTON -->

                <Button x:Name="SignInButton"
                        Content="Sign In"
                        Height="46"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#00ff89"
                        Foreground="Black"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,0,14"
                        Click="SignIn_Click"/>

                <!-- REGISTER BUTTON -->

                <Button x:Name="RegisterButton"
                        Content="Create Account"
                        Height="46"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Register_Click"/>

                <!-- FOOTER -->

                <TextBlock Text="KWIZY © 2026"
                           Foreground="#6B7280"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"/>

            </StackPanel>

        </Border>

    </Grid>
</Page>